<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <EditText android:id="@+id/pf_user" android:hint="Username (ex.: ana)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/pf_name" android:hint="Nome de exibição"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/pf_bio" android:hint="Bio"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/pf_salvar" android:text="Salvar perfil"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/pf_listar" android:text="Listar perfis"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/pf_resultado"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scrollbars="vertical" android:layout_marginTop="8dp" />
</LinearLayout>
